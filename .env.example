MONGODB_URI=mongodb://127.0.0.1:27017/medicare_erp
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123

# Optional: printed on pharmacy bills
HOSPITAL_NAME=MediCare Hospital Pharmacy
HOSPITAL_ADDRESS=
HOSPITAL_PHONE=
HOSPITAL_GSTIN=
PHARMACY_DL_NO=

# Optional: password used by npm run create-demo-admins (default Medicare@123)
DEMO_ADMIN_PASSWORD=

# Optional: encrypts saved Razorpay key secrets (defaults to AUTH_SECRET).
# Changing it (or AUTH_SECRET when unset) means Razorpay keys must be entered again.
PAYMENT_KEYS_SECRET=

# Optional: Google Gemini for AI automation (https://aistudio.google.com/apikey).
# GEMINI_FALLBACK_MODEL is tried when the main model is rate-limited or out of quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional: biometric attendance machines (HR → Biometric Attendance) sync their clock
# to this UTC offset in hours, e.g. 5.5 for India. Leave blank to keep the machine's own clock.
BIOMETRIC_TIMEZONE=
